<?xml version="1.0" encoding="utf-8"?>
<!-- Circle with the icon on top, as one image so it stays round when the widget is resized. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/torch_off" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_flashlight_off"
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</layer-list>
